{
  "name": "epoch-extension",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/databento/epoch"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run prepare:fonts && tsc && vite build",
    "prepare:fonts": "mkdir -p public/fonts && cp node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2 public/fonts/InterVariable.woff2",
    "preview": "vite preview",
    "lint": "eslint src/",
    "test": "bash scripts/test.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@types/chrome": "^0.1.9",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.43.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "dayjs": "^1.11.18"
  }
}
